<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="AwesomeAssertions" />
    <!-- PublishTraceContinuityTests builds its own TracerProvider (no ASP.NET Core/Observability
         building block involved here) to capture the spans TracingOutgoingStep/TracingIncomingStep
         start — the same idiom SbaCars.Gateway.Tests uses. -->
    <PackageReference Include="OpenTelemetry.Exporter.InMemory" />
  </ItemGroup>

  <ItemGroup>
    <!-- Plain Microsoft.Extensions.DependencyInjection + Rebus.ServiceProvider's own
         ServiceProviderExtensions.StartHostedServices (both already flow transitively from
         SbaCars.BuildingBlocks.Messaging below) are enough to boot a real bus in-process — no
         ASP.NET Core TestServer/WebApplication needed, unlike most other integration test projects
         in this solution. -->
    <ProjectReference Include="..\..\src\BuildingBlocks\SbaCars.BuildingBlocks.Messaging\SbaCars.BuildingBlocks.Messaging.csproj" />
    <ProjectReference Include="..\SbaCars.TestKit\SbaCars.TestKit.csproj" />
  </ItemGroup>

</Project>
