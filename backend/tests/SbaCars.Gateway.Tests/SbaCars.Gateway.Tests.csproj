<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <!-- A8 — captures the spans InstrumentedDestinationStub's and the gateway's own tracer
         providers end, so TraceContinuityTests can assert on them directly. -->
    <PackageReference Include="OpenTelemetry.Exporter.InMemory" />
  </ItemGroup>

  <ItemGroup>
    <!-- Both gateway hosts, driven end to end via WebApplicationFactory<Program> (needs the
         InternalsVisibleTo each gateway .csproj grants this project). Top-level statements put
         the compiler-generated Program class in the global namespace of its own assembly, not
         under the project's root namespace — with two such assemblies referenced, "Program" is
         ambiguous unless each is aliased, hence Aliases below and `extern alias` at the top of
         every file that names one. -->
    <ProjectReference Include="..\..\src\Gateways\SbaCars.Gateway.Public\SbaCars.Gateway.Public.csproj">
      <Aliases>GatewayPublic</Aliases>
    </ProjectReference>
    <ProjectReference Include="..\..\src\Gateways\SbaCars.Gateway.Backoffice\SbaCars.Gateway.Backoffice.csproj">
      <Aliases>GatewayBackoffice</Aliases>
    </ProjectReference>
    <!-- Referenced only for its public RateLimitingPolicies constant, so a route-table assertion
         never drifts from the actual policy name in code. -->
    <ProjectReference Include="..\..\src\BuildingBlocks\SbaCars.BuildingBlocks.Web\SbaCars.BuildingBlocks.Web.csproj" />
    <!-- A8 — InstrumentedDestinationStub calls the real AddSbaCarsObservability directly. -->
    <ProjectReference Include="..\..\src\BuildingBlocks\SbaCars.BuildingBlocks.Observability\SbaCars.BuildingBlocks.Observability.csproj" />
  </ItemGroup>

</Project>
