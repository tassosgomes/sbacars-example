<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="AwesomeAssertions" />
    <!-- Captures the spans TracingOutgoingStep/TracingIncomingStep start, the same in-memory
         idiom SbaCars.Gateway.Tests uses for TraceContinuityTests — see MessagingTracingStepsTests. -->
    <PackageReference Include="OpenTelemetry.Exporter.InMemory" />
  </ItemGroup>

  <ItemGroup>
    <!-- Unit-level only (no Docker, no broker): exercises the pipeline steps, the options
         validator and the topic convention directly against Rebus' own pipeline-context types,
         without opening a connection. Testcontainers-backed coverage (topology declared on the
         real broker, retry/error queue, connection budget, end-to-end trace propagation) lives in
         SbaCars.Messaging.IntegrationTests instead. -->
    <ProjectReference Include="..\..\src\BuildingBlocks\SbaCars.BuildingBlocks.Messaging\SbaCars.BuildingBlocks.Messaging.csproj" />
  </ItemGroup>

</Project>
