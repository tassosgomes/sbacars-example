{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "inventory": {
        "ClusterId": "inventory",
        "Match": {
          "Path": "/api/inventory/{**rest}"
        },
        "AuthorizationPolicy": "Default",
        "Transforms": [
          { "PathRemovePrefix": "/api/inventory" },
          { "PathPrefix": "/api" }
        ]
      },
      "catalog": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/catalog/{**rest}"
        },
        "AuthorizationPolicy": "Default",
        "Transforms": [
          { "PathRemovePrefix": "/api/catalog" },
          { "PathPrefix": "/api" }
        ]
      },
      "interest": {
        "ClusterId": "interest",
        "Match": {
          "Path": "/api/interest/{**rest}"
        },
        "AuthorizationPolicy": "Default",
        "Transforms": [
          { "PathRemovePrefix": "/api/interest" },
          { "PathPrefix": "/api" }
        ]
      },
      "purchase": {
        "ClusterId": "purchase",
        "Match": {
          "Path": "/api/purchase/{**rest}"
        },
        "AuthorizationPolicy": "Default",
        "Transforms": [
          { "PathRemovePrefix": "/api/purchase" },
          { "PathPrefix": "/api" }
        ]
      }
    },
    "Clusters": {
      "inventory": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        }
      },
      "catalog": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        }
      },
      "interest": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        }
      },
      "purchase": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        }
      }
    }
  }
}
