{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "catalog-read": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/catalog/{**rest}",
          "Methods": [ "GET", "HEAD", "OPTIONS" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/catalog" },
          { "PathPrefix": "/api" }
        ]
      },
      "interest-write": {
        "ClusterId": "interest",
        "Match": {
          "Path": "/api/interest/{**rest}",
          "Methods": [ "POST", "OPTIONS" ]
        },
        "RateLimiterPolicy": "sbacars-anonymous-strict",
        "Transforms": [
          { "PathRemovePrefix": "/api/interest" },
          { "PathPrefix": "/api" }
        ]
      }
    },
    "Clusters": {
      "catalog": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        }
      },
      "interest": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        }
      }
    }
  }
}
