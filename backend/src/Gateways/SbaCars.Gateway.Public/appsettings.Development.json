{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "SegmentsPerWindow": 4,
    "QueueLimit": 0,
    "AnonymousStrictPermitLimit": 10,
    "AnonymousStrictWindowSeconds": 60
  },
  "ReverseProxy": {
    "Clusters": {
      "catalog": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5010"
          }
        }
      },
      "interest": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5030"
          }
        }
      }
    }
  }
}
