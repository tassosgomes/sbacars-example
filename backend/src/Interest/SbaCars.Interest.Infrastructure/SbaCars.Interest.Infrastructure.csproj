<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\SbaCars.Interest.Domain\SbaCars.Interest.Domain.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\SbaCars.BuildingBlocks.Persistence\SbaCars.BuildingBlocks.Persistence.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Design-time only: used by "dotnet ef migrations add" via the service's design-time
         factory. Never needed at runtime, so it must not flow to anything referencing this
         project. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- A8 — Npgsql's own OpenTelemetry tracing (§8), wired here and not in
         BuildingBlocks.Observability: only the four services' Infrastructure talk to Postgres,
         and BuildingBlocks.Observability is also referenced by the two gateways, which never
         should carry Npgsql (§3.3). ConfigureOpenTelemetryTracerProvider composes additively with
         whatever AddSbaCarsObservability already registered in Program.cs, in either call order. -->
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="Npgsql.OpenTelemetry" />
  </ItemGroup>
</Project>
